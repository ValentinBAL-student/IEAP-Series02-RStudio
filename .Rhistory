ggplot(
snore,
aes(x = snore, y = weight, fill = snore)
) +
geom_boxplot(alpha = 0.7, outlier.shape = NA) +
geom_jitter(
width = 0.15,
size = 2,
alpha = 0.7,
color = "black"
) +
scale_fill_manual(
values = c(
"No" = "steelblue",
"Yes" = "tomato"
)
) +
labs(
title = "Body weight of snorers and non-snorers",
x = "Snoring status",
y = "Weight (kg)"
) +
theme_minimal() +
theme(
legend.position = "none"
)
library(tidyverse)
snore <- read.table(
"data/snore.txt",
header = TRUE
)
library(tidyverse)
snore <- read.table(
"IEAP-Series02-RStudio/data/snore.txt",
header = TRUE
)
